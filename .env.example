# Copy to .env and adjust. Every value is optional: unset means auto-detect.

# Chromium / headless shell used for rendering. Unset → a Playwright headless shell if one is
# installed, otherwise Remotion downloads its own on the first render.
# REMOTION_BROWSER=/path/to/headless_shell

# Python 3 interpreter for tools/ (verify, brief, master, sfx, brand).
# CUTROOM_PYTHON=python3

# Frames rendered in parallel: a number or a percentage of CPU cores. Unset → Remotion's default.
# CUTROOM_CONCURRENCY=50%

# ffmpeg / ffprobe binaries for the Python tools. Unset → whatever is on PATH.
# FFMPEG=ffmpeg
# FFPROBE=ffprobe

# Motion-blur engine: "camera" (default, works everywhere) or "canvas" (HTML-in-canvas, real
# shutter; needs Remotion's own headless shell, Chromium 149+). Compare first:
#   cd remotion-base && node scripts/blur-ab.mjs SamplePost 130 165
# CUTROOM_BLUR_ENGINE=camera
